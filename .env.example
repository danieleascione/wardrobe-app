# =============================================================================
# PocketWardrobe — Environment Variables
#
# Copy this file to .env.local for local development.
# Never commit .env.local or any file containing real credentials.
#
# For production, store secrets in AWS SSM Parameter Store (SecureString).
# The SAM template reads them at deploy time via {{resolve:ssm:...}}.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase
#
# Local dev:  values printed by `supabase start`
# Production: found in Supabase dashboard → Settings → API
# -----------------------------------------------------------------------------

# Supabase project URL
# Local:      http://localhost:54321
# Production: https://<project-ref>.supabase.co
SUPABASE_URL=http://localhost:54321

# Supabase anon key — safe for client-side use (enforced by Row Level Security)
SUPABASE_ANON_KEY=your-local-anon-key-here

# Supabase service role key — server-side only, bypasses RLS — keep secret
SUPABASE_SERVICE_ROLE_KEY=your-local-service-role-key-here

# -----------------------------------------------------------------------------
# AWS
# -----------------------------------------------------------------------------

# AWS region — must match where Lambda and S3 are deployed
# Use eu-west-1 (Frankfurt) to satisfy GDPR EU-region requirement
AWS_REGION=eu-west-1

# S3 bucket name for garment photo storage (originals + thumbnails)
S3_BUCKET_NAME=pocketwardrobe-garments-dev

# -----------------------------------------------------------------------------
# Nano Banana AI API
# -----------------------------------------------------------------------------

# Nano Banana API key — obtain from your Nano Banana dashboard
NANO_BANANA_API_KEY=your-nano-banana-api-key-here

# Nano Banana API base URL
NANO_BANANA_API_URL=https://api.nanobanana.ai

# -----------------------------------------------------------------------------
# Weather
# -----------------------------------------------------------------------------

# Open-Meteo weather cache TTL in hours.
# Cache expires at midnight local time regardless of this value —
# this controls the maximum age for cache hits during the day.
# Default: 24
OPEN_METEO_CACHE_TTL_HOURS=24

# -----------------------------------------------------------------------------
# Auth (local development only)
#
# In production, JWT validation is performed by API Gateway using the
# Supabase RS256 public key. Locally, the Express server trusts JWTs
# signed with this secret when running in LOCAL=true mode.
# -----------------------------------------------------------------------------

# JWT signing secret — local dev only, any random string works
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-random-secret-for-local-dev-only

# -----------------------------------------------------------------------------
# Local development server
# -----------------------------------------------------------------------------

# Port for the local Express server (default: 3000)
PORT=3000

# Set to true to run the Express local server instead of Lambda handlers.
# Must be set when running `pnpm dev` from packages/functions.
LOCAL=true

# Node environment.
# Use 'development' locally, 'production' on AWS Lambda.
NODE_ENV=development
